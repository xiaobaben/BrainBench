# Target / CodeAct model
BRAINBENCH_API_KEY=your_api_key_here
BRAINBENCH_BASE_URL=https://your-api-base-url/v1
BRAINBENCH_MODEL=your_model_name
BRAINBENCH_API_PROTOCOL=openai
BRAINBENCH_REQUEST_TIMEOUT_SEC=300

# Shared parser, semantic judge, and VLM judge model
PARSER_API_KEY=your_parser_api_key_here
PARSER_BASE_URL=https://your-parser-api-base-url/v1
PARSER_MODEL=your_parser_model_name
PARSER_API_PROTOCOL=openai

# Use "local" or "docker".
BRAINBENCH_CODEACT_MODE=docker
BRAINBENCH_DOCKER_IMAGE=brainbench-codeact:latest
BRAINBENCH_DOCKER_MEMORY=8g
BRAINBENCH_DOCKER_CPUS=4
