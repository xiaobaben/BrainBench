# Copy this file to .env and fill in your local credentials.
# Never commit .env to a public repository.
NEUROBENCH_API_KEY=your_api_key_here
NEUROBENCH_BASE_URL=https://your-api-base-url
NEUROBENCH_MODEL=your_model_name
NEUROBENCH_API_PROTOCOL=your_api_protocol
NEUROBENCH_REQUEST_TIMEOUT_SEC=120
BRAINBENCH_CODEACT_MODE=your_codeact_mode
BRAINBENCH_DOCKER_IMAGE=your_docker_image
BRAINBENCH_DOCKER_MEMORY=your_memory_limit
BRAINBENCH_DOCKER_CPUS=your_cpu_limit
